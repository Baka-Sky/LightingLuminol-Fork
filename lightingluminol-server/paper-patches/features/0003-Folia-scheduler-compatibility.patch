Subject: [PATCH] Folia scheduler compatibility


diff --git a/src/main/java/io/papermc/paper/plugin/manager/PaperPluginInstanceManager.java b/src/main/java/io/papermc/paper/plugin/manager/PaperPluginInstanceManager.java
index 578102113c2034ed220a4753ee5b69e0270321ce..ca4d2a84c3534d9fccd51a0262ec0e1f81b36501 100644
--- a/src/main/java/io/papermc/paper/plugin/manager/PaperPluginInstanceManager.java
+++ b/src/main/java/io/papermc/paper/plugin/manager/PaperPluginInstanceManager.java
@@ -268,6 +268,13 @@ class PaperPluginInstanceManager {
         // Folia - region threading
 
         // Paper start - Folia schedulers
+        try {
+            this.server.getScheduler().cancelTasks(plugin);
+        } catch (Throwable ex) {
+            this.handlePluginException("Error occurred (in the plugin loader) while cancelling Bukkit scheduler tasks for "
+                + pluginName + " (Is it up to date?)", ex, plugin); // Paper
+        }
+
         try {
             this.server.getGlobalRegionScheduler().cancelTasks(plugin);
         } catch (Throwable ex) {
diff --git a/src/main/java/io/papermc/paper/threadedregions/scheduler/FoliaEntityScheduler.java b/src/main/java/io/papermc/paper/threadedregions/scheduler/FoliaEntityScheduler.java
index 811b8efd155540beac19b70afa1885bff570cd3e..52548fd79b5b16c3aa3ff73457d96fdf0ff329c0 100644
--- a/src/main/java/io/papermc/paper/threadedregions/scheduler/FoliaEntityScheduler.java
+++ b/src/main/java/io/papermc/paper/threadedregions/scheduler/FoliaEntityScheduler.java
@@ -39,6 +39,11 @@ public final class FoliaEntityScheduler implements EntityScheduler {
     @Override
     public boolean execute(final Plugin plugin, final Runnable run, final Runnable retired,
                            final long delay) {
+        if (meow.bacteriawa.lightingluminol.core.FoliaSchedulerCompatibility.shouldUseBukkitScheduler(plugin)) {
+            meow.bacteriawa.lightingluminol.core.FoliaSchedulerCompatibility.runDelayedOnBukkit(plugin, task -> run.run(), Math.max(1L, delay), "Entity");
+            return true;
+        }
+
         final Consumer<? extends Entity> runNMS = wrap(plugin, run);
         final Consumer<? extends Entity> runRetired = retired == null ? null : wrap(plugin, retired);
 
@@ -63,6 +68,10 @@ public final class FoliaEntityScheduler implements EntityScheduler {
             throw new IllegalPluginAccessException("Plugin attempted to register task while disabled");
         }
 
+        if (meow.bacteriawa.lightingluminol.core.FoliaSchedulerCompatibility.shouldUseBukkitScheduler(plugin)) {
+            return meow.bacteriawa.lightingluminol.core.FoliaSchedulerCompatibility.runDelayedOnBukkit(plugin, task, delayTicks, "Entity");
+        }
+
         final EntityScheduledTask ret = new EntityScheduledTask(plugin, -1, task, retired);
 
         if (!this.scheduleInternal(ret, delayTicks)) {
@@ -93,6 +102,10 @@ public final class FoliaEntityScheduler implements EntityScheduler {
             throw new IllegalPluginAccessException("Plugin attempted to register task while disabled");
         }
 
+        if (meow.bacteriawa.lightingluminol.core.FoliaSchedulerCompatibility.shouldUseBukkitScheduler(plugin)) {
+            return meow.bacteriawa.lightingluminol.core.FoliaSchedulerCompatibility.runAtFixedRateOnBukkit(plugin, task, initialDelayTicks, periodTicks, "Entity");
+        }
+
         final EntityScheduledTask ret = new EntityScheduledTask(plugin, periodTicks, task, retired);
 
         if (!this.scheduleInternal(ret, initialDelayTicks)) {
diff --git a/src/main/java/io/papermc/paper/threadedregions/scheduler/FoliaGlobalRegionScheduler.java b/src/main/java/io/papermc/paper/threadedregions/scheduler/FoliaGlobalRegionScheduler.java
index 14ffbcb66006878eacf310547dad53718f8308eb..7bb1165ff1355bcf643865a5795aaab018702c54 100644
--- a/src/main/java/io/papermc/paper/threadedregions/scheduler/FoliaGlobalRegionScheduler.java
+++ b/src/main/java/io/papermc/paper/threadedregions/scheduler/FoliaGlobalRegionScheduler.java
@@ -42,6 +42,11 @@ public class FoliaGlobalRegionScheduler implements GlobalRegionScheduler {
         Objects.requireNonNull(plugin, "Plugin may not be null");
         Objects.requireNonNull(run, "Runnable may not be null");
 
+        if (meow.bacteriawa.lightingluminol.core.FoliaSchedulerCompatibility.shouldUseBukkitScheduler(plugin)) {
+            meow.bacteriawa.lightingluminol.core.FoliaSchedulerCompatibility.executeOnBukkit(plugin, run, "Global");
+            return;
+        }
+
         this.run(plugin, (final ScheduledTask task) -> {
             run.run();
         });
@@ -49,6 +54,13 @@ public class FoliaGlobalRegionScheduler implements GlobalRegionScheduler {
 
     @Override
     public ScheduledTask run(final Plugin plugin, final Consumer<ScheduledTask> task) {
+        Objects.requireNonNull(plugin, "Plugin may not be null");
+        Objects.requireNonNull(task, "Task may not be null");
+
+        if (meow.bacteriawa.lightingluminol.core.FoliaSchedulerCompatibility.shouldUseBukkitScheduler(plugin)) {
+            return meow.bacteriawa.lightingluminol.core.FoliaSchedulerCompatibility.runOnBukkit(plugin, task, "Global");
+        }
+
         return this.runDelayed(plugin, task, 1);
     }
 
@@ -64,6 +76,10 @@ public class FoliaGlobalRegionScheduler implements GlobalRegionScheduler {
             throw new IllegalPluginAccessException("Plugin attempted to register task while disabled");
         }
 
+        if (meow.bacteriawa.lightingluminol.core.FoliaSchedulerCompatibility.shouldUseBukkitScheduler(plugin)) {
+            return meow.bacteriawa.lightingluminol.core.FoliaSchedulerCompatibility.runDelayedOnBukkit(plugin, task, delayTicks, "Global");
+        }
+
         final GlobalScheduledTask ret = new GlobalScheduledTask(plugin, -1, task);
 
         this.scheduleInternal(ret, delayTicks);
@@ -91,6 +107,10 @@ public class FoliaGlobalRegionScheduler implements GlobalRegionScheduler {
             throw new IllegalPluginAccessException("Plugin attempted to register task while disabled");
         }
 
+        if (meow.bacteriawa.lightingluminol.core.FoliaSchedulerCompatibility.shouldUseBukkitScheduler(plugin)) {
+            return meow.bacteriawa.lightingluminol.core.FoliaSchedulerCompatibility.runAtFixedRateOnBukkit(plugin, task, initialDelayTicks, periodTicks, "Global");
+        }
+
         final GlobalScheduledTask ret = new GlobalScheduledTask(plugin, periodTicks, task);
 
         this.scheduleInternal(ret, initialDelayTicks);
@@ -106,6 +126,7 @@ public class FoliaGlobalRegionScheduler implements GlobalRegionScheduler {
     @Override
     public void cancelTasks(final Plugin plugin) {
         Objects.requireNonNull(plugin, "Plugin may not be null");
+        meow.bacteriawa.lightingluminol.core.FoliaSchedulerCompatibility.cancelTasks(plugin);
 
         final List<GlobalScheduledTask> toCancel = new ArrayList<>();
         synchronized (this.stateLock) {
