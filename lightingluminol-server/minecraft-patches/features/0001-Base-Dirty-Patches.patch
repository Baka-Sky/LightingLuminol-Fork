         entity.registerScheduler(); // Paper - optimise Folia entity scheduler
+        }finally {
+        this.world.worldDataPool.releaseReference(entity, ref.right());
+        }
     }
 
     @Override
     protected void removeEntityCallback(final Entity entity) {
+        var ref = this.world.worldDataPool.getAndHeldReference(entity);
+        var worldData = ref.left();
+        try {
         if (entity instanceof ServerPlayer player) {
-            ((ChunkSystemServerLevel)this.serverWorld).moonrise$getNearbyPlayers().removePlayer(player);
+            worldData.getNearbyPlayers().removePlayer(player);
         }
