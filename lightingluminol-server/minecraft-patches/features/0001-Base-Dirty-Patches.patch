+        var ref = this.world.worldDataPool.getAndHeldReference(entity);
+        var worldData = ref.left();
+        try {
         // Moonrise start - entity tracker
-        this.world.getCurrentWorldData().trackerEntities.add(entity); // Folia - region threading
+        worldData.trackerEntities.add(entity); // Folia - region threading
         // Moonrise end - entity tracker
+        }finally {
+        this.world.worldDataPool.releaseReference(entity, ref.right());
+        }
     }
 
     @Override
     protected void entityEndLoaded(final Entity entity) {
+        var ref = this.world.worldDataPool.getAndHeldReference(entity);
+        var worldData = ref.left();
+        try {
         // Moonrise start - entity tracker
-        this.world.getCurrentWorldData().trackerEntities.remove(entity); // Folia - region threading
+        worldData.trackerEntities.remove(entity); // Folia - region threading
         // Moonrise end - entity tracker
+        }finally {
+        this.world.worldDataPool.releaseReference(entity, ref.right());
+        }
     }
 
